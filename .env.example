# Copy this file to .env and adjust values as needed.

# PostgreSQL connection for the live app — all optional, defaults match a
# local Postgres.app/Homebrew install with trust auth (no password) on
# 127.0.0.1:5432
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=aurafi
PG_USER=postgres
PG_PASSWORD=

# postgres/ (Homework 30 standalone scripts) — its own database name, kept
# deliberately separate from PG_DB above so its demo INSERT/UPDATE/DELETE/
# ROLLBACK scripts never touch the live app's data
PG_HOMEWORK_DB=aurafi_homework30

# Demo login created by seed.py, used to log into main.py
# (placeholder values below — put your own in .env, do not reuse these)
SEED_USERNAME=demo_user
SEED_EMAIL=demo@example.com
SEED_PASSWORD=changeme123

# Homework 23 — one-shot CLI (`python main.py add ...`, as opposed to the
# interactive `python main.py` menu above) has no login step, so it needs to
# be told which user's data to operate on by default. Only used when a CLI
# command is run without its own --user-id.
CLI_USER_ID=1

# Public-ish app behavior, not secret — could live in config.ini instead, but
# BASE_CURRENCY in particular is meant to vary per environment/deployment.
DEBUG=false
LOG_LEVEL=INFO
BASE_CURRENCY=UAH

# Not used yet — wired up when Lesson 25 (HTTP + exchange-rate API) lands in
# decorators.currency_aware(). Empty is fine.
EXCHANGE_API_KEY=
